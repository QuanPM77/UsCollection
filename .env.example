# Database - Supabase PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth
AUTH_SECRET="your-secret-key-min-32-chars"

# Google OAuth (bỏ trống = tắt Google login)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# PayOS Payment (https://my.payos.vn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

APP_URL="http://localhost:3000"

# SMTP - Bắt buộc để gửi email (dùng Gmail App Password)
# Hướng dẫn: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_gmail@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="UsCollection <your_gmail@gmail.com>"
